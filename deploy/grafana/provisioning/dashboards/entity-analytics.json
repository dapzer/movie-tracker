          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, '1d') AS \"time\", 'Users' AS metric, COUNT(*) AS \"value\" FROM users WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL\nSELECT $__timeGroup(created_at, '1d'), 'Media items', COUNT(*) FROM media_items WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL\nSELECT $__timeGroup(created_at, '1d'), 'Ratings', COUNT(*) FROM media_ratings WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL\nSELECT $__timeGroup(created_at, '1d'), 'Reviews', COUNT(*) FROM media_reviews WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL\nSELECT $__timeGroup(created_at, '1d'), 'List likes', COUNT(*) FROM media_list_likes WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL\nSELECT $__timeGroup(created_at, '1d'), 'Review likes', COUNT(*) FROM media_review_likes WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL\nSELECT $__timeGroup(created_at, '1d'), 'Notifications', COUNT(*) FROM notifications WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL\nSELECT $__timeGroup(created_at, '1d'), 'Subscriptions', COUNT(*) FROM release_subscriptions WHERE $__timeFilter(created_at) GROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "New entities per day",
      "type": "timeseries"
